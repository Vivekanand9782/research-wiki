# ==============================================================================
# Research Wiki & Local RAG — Environment Configuration Template
# Copy this file to .env and supply your settings.
# cp .env.example .env
# ==============================================================================

# --- Required: Politeness Identity ---
DEFAULT_EMAIL=your_email@institution.edu

# --- Centralized LLM Hub Settings ---
# Compatible with OpenAI, OpenRouter, General Compute, DeepSeek, or local Ollama/vLLM.
GENERAL_COMPUTE_BASE_URL=https://api.generalcompute.com/v1
GENERAL_COMPUTE_MODEL=minimax-m2.7
GENERAL_COMPUTE_LONG_CONTEXT_MODEL=minimax-m2.7

# Multi-key rotation (comma-separated):
GENERAL_COMPUTE_API_KEYS=your_key_1,your_key_2
# GENERAL_COMPUTE_API_KEY=your_single_key

# Standard OpenAI-compatible fallbacks:
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# Optional model override for filtering/classification:
# FILTER_MODEL=minimax-m2.7

# --- Academic Literature APIs (Optional for citation expansion) ---
# SEMANTIC_SCHOLAR_API_KEYS=key1,key2
# OPENALEX_API_KEY=your_key

# --- Ingestion & Concurrency Settings ---
# Number of parallel workers for PDF extraction and knowledge graph generation:
# RESEARCH_WIKI_WORKERS=7
